# ============================================================
# Copy thành .env trên VPS rồi điền — KHÔNG commit file .env.
# ============================================================

# Domain đã trỏ DNS A record về IP VPS (Caddy tự xin TLS)
DOMAIN=staging-api.anthiet.vn

# Sinh ngẫu nhiên, vd: openssl rand -hex 24
POSTGRES_PASSWORD=
TYPESENSE_API_KEY=
ADMIN_KEY=

# Auth thật cho staging (đội seed dùng máy thật)
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste nguyên private key, giữ \n dạng chữ (auth.service tự chuyển):
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
