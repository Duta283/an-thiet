PORT=3000
DATABASE_URL=postgres://anthiet:anthiet_dev@localhost:5432/anthiet
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=anthiet_dev_ts_key
# Khoá bảo vệ API admin/seed (đổi khi deploy)
ADMIN_KEY=change_me_admin_key

# Auth: 'firebase' (production/staging) hoặc 'dev' (local — header x-user-id)
AUTH_MODE=dev
# Service account Firebase (Project settings > Service accounts > Generate key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Giữ nguyên \n trong private key khi paste vào env
FIREBASE_PRIVATE_KEY=
